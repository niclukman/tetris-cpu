                        rrrgggbbb_10 = 9b000000000
                        rrrgggbbb_11 = 9b000000000
                    default: 
                        rrrgggbbb_00 = 9b000000010
                        rrrgggbbb_01 = 9b010101110
                        rrrgggbbb_10 = 9b011101101
                        rrrgggbbb_11 = 9b101111111
                }
            3d6:
                case(font) {
                    8h01: 
                        rrrgggbbb_00 = 9b000000001
                        rrrgggbbb_01 = 9b000000000
                        rrrgggbbb_10 = 9b000000000
                        rrrgggbbb_11 = 9b000000000
                    default: 
