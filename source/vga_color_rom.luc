module vga_color_rom (
    input font[8],
    input level[3],
    output rrrgggbbb_00[9],
    output rrrgggbbb_01[9],
    output rrrgggbbb_10[9],
    output rrrgggbbb_11[9]
) {
    always {
        case(level) {
            default:
                case(font) {
                    8h01: 
