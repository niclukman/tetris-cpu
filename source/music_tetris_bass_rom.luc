module music_tetris_bass_rom (
    input num[16],
    output note[5],
    output beat[4]
) {
    const THINGY = $reverse({
            c{5d08, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1}, // 7
            //---------
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1}, // 15
            // ------
            c{5d08, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1}, // 23
            //---------
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1}, // 31
            //---------
            c{5d09, 4d1},
            c{5d14, 4d1},
            c{5d09, 4d1},
            c{5d14, 4d1},
            c{5d09, 4d1},
            c{5d14, 4d1},
            c{5d09, 4d1},
            c{5d14, 4d1}, // 39
            //---------
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1}, // 47
            //---------
            c{5d08, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1}, // 55
            //-------
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d4}, // 60  
            //--------
            c{5d08, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1}, // 68
            //---------
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1}, // 76
            // ------
            c{5d08, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1},
            c{5d07, 4d1},
            c{5d13, 4d1}, // 84
            //---------
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1},
            c{5d09, 4d1},
            c{5d13, 4d1}, // 92
            // --------
            c{5d00, 4d6}  // 93
        })
    always {
        beat = THINGY[num][3:0]
        note = THINGY[num][8:4]
    }
}