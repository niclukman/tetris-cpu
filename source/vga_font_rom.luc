   FPGA 16 BIT VGA 20x15 TEXT MODE FONT ROM - LUCID HDL
   SUTD 50.002 Computation Structures
   PUBLIC DOMAIN FONT https://github.com/dhepper/font8x8

*/

module vga_font_rom (
    input asciicode[8],  // clock
    input sprite,
    input row[3],
    input col[3],
    output color[2]
  ) {

  sig font[128];  
  
  always {
        case (sprite) {
            default:
                case (asciicode) {
                    // 16x8 glyph for each character (128-bit, each original bit doubled)
                    default: font = 128h00000000000000000000000000000000; // NOTHING
                    8h00: font = 128hFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF; // Bright tiles
                    8h01: font = 128h00000000000000000000000000000000; // Dark tiles
                    8h02: font = 128h0000F3F3F3F3F3F300003F3F3F3F3F3F; // TetrisBrick
                    8h05: font = 128h00000000FFFF00000000000000000000; // TopFrame
                    8h06: font = 128h0030003C000F00000000000000000000; // TopRightFrame
                    8h07: font = 128h00300030003000300030003000300030; // RightFrame
                    8h08: font = 128h00000000000000000000000F003C0030; // BotRightFrame
                    8h09: font = 128h00000000000000000000FFFF00000000; // BotFrame
                    8h0A: font = 128h00000000000000000000F0003C000C00; // BotLeftFrame
                    8h0B: font = 128h0C000C000C000C000C000C000C000C00; // LeftFrame
                    8h0C: font = 128h0C003C00F00000000000000000000000; // TopLeftFrame
                    8h0D: font = 128h0C003C00F00000000000F0003C000C00; // MidLeft
                    8h0E: font = 128h00000000FFFF00000000FFFF00000000; // MidFrame
                    8h0F: font = 128h0030003C000F00000000000F003C0030; // MidRightFrame
                    8h10: font = 128h00003FFC300C300C300C300C3FFC0000; // TetrisBlockO
                    8h11: font = 128h000029981AA829A42AA81A9829A80000; // TetrisBlockI
                    8h12: font = 128h00002AA8200823C823C820082AA80000; // TetrisBlockJ
                    8h13: font = 128h00001554155415541554155415540000; // TetrisBlockL
                    8h14: font = 128h00001554100413C413C4100415540000; // TetrisBlockS
                    8h15: font = 128h00002AA8200822B822B82FF82AA80000; // TetrisBlockT
                    8h16: font = 128h00002AA82AA8282828282AA82AA80000; // TetrisBlockZ
                    8h30: font = 128hFFFFF00FC3C3C3C3C3C3C3C3F00FFFFF; // (0)
                    8h31: font = 128hFFFFF00FFC3FFC3FFC3FFC0FFC3FFFFF; // (1)
                    8h32: font = 128hFFFFC003FF03F00FC0FFC0F3F00FFFFF; // (2)
                    8h33: font = 128hFFFFF003C0FFC0FFF00FC0FFF003FFFF; // (3)
                    8h34: font = 128hFFFFF0FFC003C0F3F0F3F0C3F00FFFFF; // (4)
                    8h35: font = 128hFFFFF00FC0F3C0FFF003FFC3F003FFFF; // (5)
                    8h36: font = 128hFFFFF00FC3C3C3C3F003FFC3F00FFFFF; // (6)
                    8h37: font = 128hFFFFFC0FFC0FFC3FF0FFC3FFC003FFFF; // (7)
                    8h38: font = 128hFFFFF00FC0F3C0F3F00FC0F3F00FFFFF; // (8)
                    8h39: font = 128hFFFFF00FC0FFC00FC0F3C0F3F00FFFFF; // (9)
                    8h43: font = 128hFFFFF00FC3C3FFC3FFC3C3C3F00FFFFF; // (C)
                    8h45: font = 128hFFFFC003FFC3FFC3F003FFC3C003FFFF; // (E)
                    8h49: font = 128hFFFFF00FFC3FFC3FFC3FFC3FF00FFFFF; // (I)
                    8h4C: font = 128hFFFFC003FFC3FFC3FFC3FFC3FFC3FFFF; // (L)
                    8h4E: font = 128hFFFFC3F3C3F3C033C303C3C3C3F3FFFF; // (N)
                    8h4F: font = 128hFFFFF00FC3C3C3C3C3C3C3C3F00FFFFF; // (O)
                    8h52: font = 128hFFFFC3C3FCC3F003C3C3C3C3F003FFFF; // (R)
                    8h53: font = 128hFFFFF00FC0F3C0FFF00FFFC3F00FFFFF; // (S)
                    8h56: font = 128hFFFFFC3FF0CFC3F3C3F3C3F3C3F3FFFF; // (V)
                    8h57: font = 128hFFFFC00FC3C3C0C3FFF3C3C3F00FFFFF; // (G)
                    8h58: font = 128hFFFFC3F3C3F3C003C3F3C3F3F00FFFFF; // (A)
                    8h59: font = 128hFFFFC3F3C3F3C333C003C0C3C3F3FFFF; // (M)
                }
            1b1:
                case (asciicode) {
                    // 16x8 glyph for each character (128-bit, each original bit doubled)
                    default: font = 128h00000000000000000000000000000000; // NOTHING
                    8h00: font = 128hFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF; // Bright tiles
                    8h01: font = 128h00000000000000000000000000000000; // Dark tiles
                    8h02: font = 128h0000F3F3F3F3F3F300003F3F3F3F3F3F; // TetrisBrick
                    8h05: font = 128h00000000FFFF00000000000000000000; // TopFrame
                    8h06: font = 128h0030003C000F00000000000000000000; // TopRightFrame
                    8h07: font = 128h00300030003000300030003000300030; // RightFrame
                    8h08: font = 128h00000000000000000000000F003C0030; // BotRightFrame
                    8h09: font = 128h00000000000000000000FFFF00000000; // BotFrame
                    8h0A: font = 128h00000000000000000000F0003C000C00; // BotLeftFrame
                    8h0B: font = 128h0C000C000C000C000C000C000C000C00; // LeftFrame
                    8h0C: font = 128h0C003C00F00000000000000000000000; // TopLeftFrame
                    8h0D: font = 128h0C003C00F00000000000F0003C000C00; // MidLeft
                    8h0E: font = 128h00000000FFFF00000000FFFF00000000; // MidFrame
                    8h0F: font = 128h0030003C000F00000000000F003C0030; // MidRightFrame
                    8h10: font = 128h00003FFC355C1FF43FFC37DC3FFC0000; // TetrisBlockO
                    8h11: font = 128h00003FFC1FF4355C3FFC37DC3FFC0000; // TetrisBlockI
                    8h12: font = 128hF3CFF00FF00FFC3FC3C3C3C3FFFFFFFF; // TetrisBlockJ
                    8h13: font = 128hFFFFFAAFF14FFAAF3FFCFFFFFFFFFFFF; // TetrisBlockL
                    8h14: font = 128hF00FF3CFFD7FEBEBFFFF3FFC00000000; // TetrisBlockS
                    8h15: font = 128hFD7FF96FFD7FE7DBC003FFFFFFFFFFFF; // TetrisBlockT
                    8h16: font = 128hA14AA00AA00AFEBFCEB3FEBFAAAAAAAA; // TetrisBlockZ
                    8h30: font = 128hFFFFF00FC3C3C3C3C3C3C3C3F00FFFFF; // (0)
                    8h31: font = 128hFFFFF00FFC3FFC3FFC3FFC0FFC3FFFFF; // (1)
                    8h32: font = 128hFFFFC003FF03F00FC0FFC0F3F00FFFFF; // (2)
                    8h33: font = 128hFFFFF003C0FFC0FFF00FC0FFF003FFFF; // (3)
                    8h34: font = 128hFFFFF0FFC003C0F3F0F3F0C3F00FFFFF; // (4)
                    8h35: font = 128hFFFFF00FC0F3C0FFF003FFC3F003FFFF; // (5)
                    8h36: font = 128hFFFFF00FC3C3C3C3F003FFC3F00FFFFF; // (6)
                    8h37: font = 128hFFFFFC0FFC0FFC3FF0FFC3FFC003FFFF; // (7)
                    8h38: font = 128hFFFFF00FC0F3C0F3F00FC0F3F00FFFFF; // (8)
                    8h39: font = 128hFFFFF00FC0FFC00FC0F3C0F3F00FFFFF; // (9)
                    8h43: font = 128hFFFFF00FC3C3FFC3FFC3C3C3F00FFFFF; // (C)
                    8h45: font = 128hFFFFC003FFC3FFC3F003FFC3C003FFFF; // (E)
                    8h49: font = 128hFFFFF00FFC3FFC3FFC3FFC3FF00FFFFF; // (I)
                    8h4C: font = 128hFFFFC003FFC3FFC3FFC3FFC3FFC3FFFF; // (L)
                    8h4E: font = 128hFFFFC3F3C3F3C033C303C3C3C3F3FFFF; // (N)
                    8h4F: font = 128hFFFFF00FC3C3C3C3C3C3C3C3F00FFFFF; // (O)
                    8h52: font = 128hFFFFC3C3FCC3F003C3C3C3C3F003FFFF; // (R)
                    8h53: font = 128hFFFFF00FC0F3C0FFF00FFFC3F00FFFFF; // (S)
                    8h56: font = 128hFFFFFC3FF0CFC3F3C3F3C3F3C3F3FFFF; // (V)
                    8h57: font = 128hFFFFC00FC3C3C0C3FFF3C3C3F00FFFFF; // (G)
                    8h58: font = 128hFFFFC3F3C3F3C003C3F3C3F3F00FFFFF; // (A)
                    8h59: font = 128hFFFFC3F3C3F3C333C003C0C3C3F3FFFF; // (M)
                }
        }
    
        color = font[((row << 3) + col) << 1 +: 2];
    }
}