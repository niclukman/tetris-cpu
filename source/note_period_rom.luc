module note_period_rom (
    input note[5],
    output count[32]
) {
    const PERIODS = $reverse({
            32d0,
            32d909091,
            32d809913,
            32d764467,
            32d681060,
            32d606759,
            32d572705,
            32d510204,
            32d481579,
            32d454545,
            32d404956,
            32d382219,
            32d340530,
            32d303370,
            32d286336,
            32d255102,
            32d227272,
            32d202478,
            32d191113,
            32d170262,
            32d151687,
            32d143172,
            32d127552,
            32d113636,
            32d240890
    })
    
    always {
        if (note > 24) {
            count = 0
        } else {
            count = PERIODS[note]
        }
    }
}